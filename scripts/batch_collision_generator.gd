
@tool
extends EditorScript

const GENERATED_NAME: String = "AutoGeneratedCollision"


func _run() -> void:
	var scene_root: Node = EditorInterface.get_edited_scene_root()

	if scene_root == null:
		push_error("Open main.tscn before running.")
		return

	var selection: EditorSelection = EditorInterface.get_selection()
	var selected_nodes: Array[Node] = selection.get_selected_nodes()

	if selected_nodes.is_empty():
		push_warning("Select asset roots in the Scene tree first.")
		return

	var created: int = 0
	var skipped: int = 0

	for asset in selected_nodes:
		if not asset is Node3D:
			skipped += 1
			continue

		if _has_collision(asset):
			print("Skipped existing collision: ", asset.name)
			skipped += 1
			continue

		var meshes: Array[MeshInstance3D] = []
		_collect_meshes(asset, meshes)

		var bounds: AABB = AABB()
		var has_bounds: bool = false

		for mesh_instance in meshes:
			if mesh_instance.mesh == null:
				continue

			var mesh_bounds: AABB = mesh_instance.mesh.get_aabb()

			var mesh_transform: Transform3D = (
				asset.global_transform.affine_inverse()
				* mesh_instance.global_transform
			)

			var transformed: AABB = mesh_transform * mesh_bounds

			if not has_bounds:
				bounds = transformed
				has_bounds = true
			else:
				bounds = bounds.merge(transformed)

		if not has_bounds or bounds.size.length() < 0.01:
			print("Skipped asset without valid mesh bounds: ", asset.name)
			skipped += 1
			continue

		var body: StaticBody3D = StaticBody3D.new()
		body.name = GENERATED_NAME
		asset.add_child(body)
		body.owner = scene_root

		var shape_node: CollisionShape3D = CollisionShape3D.new()
		shape_node.name = "CollisionShape"

		var shape: BoxShape3D = BoxShape3D.new()
		shape.size = bounds.size
		shape_node.shape = shape
		shape_node.position = bounds.position + bounds.size / 2.0

		body.add_child(shape_node)
		shape_node.owner = scene_root

		created += 1
		print("Created simple collision: ", asset.name)

	if created > 0:
		EditorInterface.mark_scene_as_unsaved()

	print("Finished. Created: ", created, " | Skipped: ", skipped)


func _collect_meshes(
	node: Node,
	result: Array[MeshInstance3D]
) -> void:
	if node is MeshInstance3D:
		result.append(node as MeshInstance3D)

	for child in node.get_children():
		_collect_meshes(child, result)


func _has_collision(node: Node) -> bool:
	if node is CollisionShape3D or node is CollisionPolygon3D:
		return true

	for child in node.get_children():
		if _has_collision(child):
			return true

	return false
